---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { db } from '../lib/db/client';
import { users } from '../lib/db/schema';
import { eq } from 'drizzle-orm';

interface SessionUser {
  userId: string;
  steamId: string;
}

interface Props {
  user?: SessionUser | null;
  /** Show the theme switch (only on pages that use the design tokens). */
  themeToggle?: boolean;
  /** Steam glyph on the login button (only on pages that show Steam data, decisiones A19). */
  loginGlyph?: boolean;
}

const { user = null, themeToggle = false, loginGlyph = true } = Astro.props;

let profile: { personaName: string | null; avatarUrl: string | null } | null = null;
if (user && db) {
  const row = (
    await db
      .select({ personaName: users.personaName, avatarUrl: users.avatarUrl })
      .from(users)
      .where(eq(users.id, user.userId))
      .limit(1)
  )[0];
  profile = row ?? null;
}

const displayName = (profile?.personaName || 'Mi cuenta').trim();
const initial = [...displayName][0]?.toUpperCase() ?? '?';
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label="mysteamlib — inicio">
      <img class="brand-logo brand-logo-dark" src="/mysteamlib-iso-dark.svg" alt="" width="26" height="20" />
      <img class="brand-logo brand-logo-light" src="/mysteamlib-iso-light.svg" alt="" width="26" height="20" />
      <span class="brand-name" translate="no">mysteamlib</span>
    </a>

    <div class="side">
      {themeToggle && <ThemeToggle />}
      {user ? (
        <>
          <a
            class="chip"
            href="/dashboard"
            title="Ir a mi dashboard"
            aria-label="Ir a mi dashboard"
          >
            {profile?.avatarUrl ? (
              <img
                class="chip-avatar"
                src={profile.avatarUrl}
                alt=""
                width="28"
                height="28"
                loading="eager"
                referrerpolicy="no-referrer"
              />
            ) : (
              <span class="chip-fallback" aria-hidden="true">{initial}</span>
            )}
            <span class="chip-name">{displayName}</span>
          </a>
          <form method="POST" action="/api/auth/logout">
            <button class="logout" type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">
              <Icon name="log-out" size={18} />
            </button>
          </form>
        </>
      ) : (
        <a class="login" href="/api/auth/login">
          {loginGlyph && <Icon name="steam" size={18} />}
          Iniciar sesión con Steam
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border, var(--color-border));
    background: color-mix(in srgb, var(--bg, var(--color-bg)) 80%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
  }
  /* Same container as the landing `main-content`. Other pages keep their own widths (legal 46rem,
     dashboard 56rem, platino 96rem) until the Phase 12 redesign, so there it only centres. */
  .bar {
    inline-size: min(var(--container, 72rem), calc(100% - 2 * var(--space-gutter, 1.5rem)));
    margin-inline: auto;
    min-block-size: var(--header-h, 3.875rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--text, var(--color-text));
  }
  /* The isotype is 800×601 (not square) and ships one file per theme. */
  .brand-logo {
    width: 26px;
    height: 20px;
    display: block;
  }
  .brand-logo-light {
    display: none;
  }
  :root[data-theme='light'] .brand-logo-dark {
    display: none;
  }
  :root[data-theme='light'] .brand-logo-light {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .brand-logo-dark {
      display: none;
    }
    :root:not([data-theme]) .brand-logo-light {
      display: block;
    }
  }

  .side {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.22rem 0.85rem 0.22rem 0.22rem;
    border: 1px solid transparent;
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .chip:hover {
    border-color: color-mix(in srgb, var(--accent, var(--color-accent)) 55%, var(--border, var(--color-border)));
    background: var(--surface-2, var(--color-surface-2));
    transform: translateY(-1px);
  }
  .chip-avatar,
  .chip-fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .chip-fallback {
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-2, var(--color-accent-text));
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent, var(--color-accent)) 25%, transparent),
      color-mix(in srgb, var(--accent-2, var(--color-accent)) 25%, transparent)
    );
  }
  .chip-name {
    font-size: 0.85rem;
    font-weight: 600;
    max-width: 12rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .logout {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    color: var(--muted, var(--color-text-muted));
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .logout:hover {
    color: var(--text, var(--color-text));
    border-color: color-mix(in srgb, var(--color-danger) 45%, var(--border, var(--color-border)));
    background: color-mix(in srgb, var(--color-danger) 35%, transparent);
  }

  .login {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    padding: 0 var(--space-4, 1rem);
    border-radius: var(--radius-pill, 999px);
    background: var(--color-accent, var(--accent));
    color: var(--color-on-accent, var(--bg));
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .login:hover {
    background: var(--color-accent-hover, var(--color-accent, var(--accent)));
  }

  .site-header a:focus-visible,
  .site-header button:focus-visible {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 2px;
  }

  @media (max-width: 719px) {
    .chip-name {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .brand-name {
      display: none;
    }
    .login {
      padding: 0 0.85rem;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip,
    .logout,
    .login {
      transition: none;
    }
    .chip:hover {
      transform: none;
    }
  }
</style>
