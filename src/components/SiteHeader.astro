---
import { db } from '../lib/db/client';
import { users } from '../lib/db/schema';
import { eq } from 'drizzle-orm';

interface SessionUser {
  userId: string;
  steamId: string;
}

interface Props {
  user?: SessionUser | null;
  page?: 'home' | 'dashboard' | 'platino' | 'sync';
}

const { user = null, page = 'home' } = Astro.props;

let profile: { personaName: string | null; avatarUrl: string | null } | null = null;
if (user && db) {
  const row = (
    await db
      .select({ personaName: users.personaName, avatarUrl: users.avatarUrl })
      .from(users)
      .where(eq(users.id, user.userId))
      .limit(1)
  )[0];
  profile = row ?? null;
}

const displayName = (profile?.personaName || 'Mi cuenta').trim();
const initial = [...displayName][0]?.toUpperCase() ?? '?';
---

<header class="site-header">
  <a class="brand" href="/" aria-label="mysteamlib — inicio">
    <img class="brand-logo" src="/logo.svg" alt="" width="26" height="26" />
    <span class="brand-name" translate="no">mysteamlib</span>
  </a>

  {user ? (
    <>
      <nav class="nav" aria-label="Navegación principal">
        <a href="/dashboard" aria-current={page === 'dashboard' ? 'page' : undefined}>
          Mi Dashboard
        </a>
        <a href="/platino" aria-current={page === 'platino' ? 'page' : undefined}>
          Mi próximo platino
        </a>
      </nav>

      <div class="side">
        <a
          class="chip"
          href="/dashboard"
          title="Ir a mi dashboard"
          aria-label="Ir a mi dashboard"
        >
          {profile?.avatarUrl ? (
            <img
              class="chip-avatar"
              src={profile.avatarUrl}
              alt=""
              width="28"
              height="28"
              loading="eager"
              referrerpolicy="no-referrer"
            />
          ) : (
            <span class="chip-fallback" aria-hidden="true">{initial}</span>
          )}
          <span class="chip-name">{displayName}</span>
        </a>
        <form method="POST" action="/api/auth/logout">
          <button class="ghost" type="submit">Cerrar sesión</button>
        </form>
      </div>
    </>
  ) : (
    <>
      <nav class="nav" aria-label="Productos y herramientas">
        <a class="tool" href="/api/auth/login?next=/dashboard" title="Requiere iniciar sesión">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          Mi Dashboard
        </a>
        <a class="tool" href="/api/auth/login?next=/platino" title="Requiere iniciar sesión">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          Mi próximo platino
        </a>
      </nav>

      <div class="side">
        <a class="steam-sign-in" href="/api/auth/login" title="Iniciar sesión con Steam">
          <img
            src="https://community.fastly.steamstatic.com/public/images/signinthroughsteam/sits_01.png"
            alt="Sign in through Steam"
            width="180"
            height="35"
            loading="eager"
          />
        </a>
      </div>
    </>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.6rem 1rem;
    min-height: var(--header-h, 3.875rem);
    padding: 0.6rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg, #0a0e17) 80%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--text, #f1f5f9);
  }
  .brand-logo {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: block;
  }

  .nav {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.25rem 1rem;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  .nav a {
    color: var(--muted, #94a3b8);
    text-decoration: none;
    padding: 0.25rem 0.15rem;
    border-radius: 6px;
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--text, #f1f5f9);
  }
  .nav a[aria-current='page'] {
    color: var(--text, #f1f5f9);
    font-weight: 600;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tool svg {
    color: var(--accent, #7c8dff);
    flex: none;
  }

  .side {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.22rem 0.85rem 0.22rem 0.22rem;
    border: 1px solid transparent;
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .chip:hover {
    border-color: color-mix(in srgb, var(--accent, #7c8dff) 55%, var(--border));
    background: var(--surface-2, rgba(148, 163, 184, 0.08));
    transform: translateY(-1px);
  }
  .chip-avatar,
  .chip-fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .chip-fallback {
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-2, #b06ab3);
    background: linear-gradient(135deg, rgba(124, 141, 255, 0.25), rgba(176, 106, 179, 0.25));
  }
  .chip-name {
    font-size: 0.85rem;
    font-weight: 600;
    max-width: 12rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ghost {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted, #94a3b8);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .ghost:hover {
    color: var(--text, #f1f5f9);
    border-color: color-mix(in srgb, var(--accent-3, #ff7c7c) 45%, var(--border, #b8949429));
    background: var(--accent-3, rgba(239, 0, 0, 0.549));
    transform: translateY(-1px);
  }

  .steam-sign-in {
    display: block;
    line-height: 0;
    border-radius: 4px;
  }
  .steam-sign-in img {
    display: block;
  }

  .site-header a:focus-visible,
  .site-header button:focus-visible {
    outline: 2px solid var(--accent, #7c8dff);
    outline-offset: 2px;
  }

  @media (min-width: 720px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
    }
    .nav {
      grid-column: 2;
      justify-content: center;
    }
  }

  @media (max-width: 719px) {
    .chip-name {
      display: none;
    }
    .site-header {
      padding: 0.55rem 1rem 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a,
    .chip,
    .ghost {
      transition: none;
    }
  }
</style>