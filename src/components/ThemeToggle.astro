---
// Theme switch. Default = OS preference; a click stores the choice in
// localStorage ('mysteamlib-theme' = 'light' | 'dark'). Needs the head script in
// BaseLayout (themed) to avoid a flash on load. Disclosed in privacidad.astro.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a tema claro">
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<script>
  const KEY = 'mysteamlib-theme';
  const root = document.documentElement;
  const dark = matchMedia('(prefers-color-scheme: dark)');

  const effective = (): 'light' | 'dark' => {
    const set = root.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return dark.matches ? 'dark' : 'light';
  };

  const sync = () => {
    const mode = effective();
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.dataset.mode = mode;
      btn.setAttribute('aria-label', mode === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
    }
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      // storage blocked: the choice lasts until reload
    }
    sync();
  });

  dark.addEventListener('change', sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-body);
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .theme-toggle:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .icon-sun {
    display: none;
  }
  /* In dark mode the action is "go light": show the sun */
  .theme-toggle[data-mode='dark'] .icon-moon {
    display: none;
  }
  .theme-toggle[data-mode='dark'] .icon-sun {
    display: block;
  }
</style>
