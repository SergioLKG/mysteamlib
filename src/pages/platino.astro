---
import LibraryExplorer from '../components/LibraryExplorer.svelte';
import DashLayout from '../layouts/DashLayout.astro';
import { db } from '../lib/db/client';
import { users } from '../lib/db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
const title = 'Mi próximo platino · mysteamlib';
const description =
  'Mis juegos de Steam con logros pendientes, ordenados por lo cerca que estoy del 100 %. Filtro y decido cuál platinar ahora.';

const REFRESH_TTL_MS = 6 * 60 * 60 * 1000;

let syncing = false;
let autoRefresh = false;
if (db) {
  const row = await db
    .select({ lastSyncedAt: users.lastSyncedAt })
    .from(users)
    .where(eq(users.id, user.userId))
    .limit(1);
  // First login without imported data → pasarela de primera carga.
  if (row[0] && !row[0].lastSyncedAt) {
    return Astro.redirect('/sync?from=/platino');
  }
  syncing = !row[0]?.lastSyncedAt;
  autoRefresh = !!row[0]?.lastSyncedAt && Date.now() - row[0].lastSyncedAt.getTime() > REFRESH_TTL_MS;
}
---

<DashLayout {title} {description} page="platino" user={user}>
  <main id="main-content" class="page">
    <div class="hero">
      <h1>Mi próximo platino</h1>
      <p class="lede">
        Los juegos con logros pendientes, ordenados por lo cerca que está cada uno del
        100&nbsp;%. Filtra por logros, horas o género y decide cuál toca platinar.
      </p>
    </div>

    <LibraryExplorer client:load {syncing} {autoRefresh} />
  </main>
</DashLayout>

<style>
  .page {
    max-width: min(96rem, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  .hero {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .hero h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
    text-wrap: balance;
    background: linear-gradient(90deg, #a5b4fc, #e0a3e3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    margin: 0 auto;
    color: var(--muted);
    max-width: 44rem;
    line-height: 1.5;
  }
</style>