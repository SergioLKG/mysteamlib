---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSpines from '../components/HeroSpines.astro';
import Icon from '../components/Icon.astro';
import ProfileLookup from '../components/ProfileLookup.svelte';

const user = Astro.locals.user;
const title = 'mysteamlib: elige qué jugar de tu biblioteca de Steam';
const description =
  'Pega tu perfil de Steam y mira tu biblioteca pública al momento. Inicia sesión con Steam para ver qué juegos tienes más cerca de platinar.';

const loginHref = '/api/auth/login?next=';
const toolHref = (path: string) => (user ? path : `${loginHref}${path}`);

// One capsule per tool. Flip `ready` when a tool ships (decisiones A17); unbuilt ones stay "Próximamente".
const tools = [
  {
    icon: 'trophy',
    title: 'Mi próximo platino',
    desc: 'Tus juegos ordenados por lo cerca que estás de platinarlos.',
    ready: true,
    href: toolHref('/platino'),
  },
  {
    icon: 'gamepad-2',
    title: 'Mi biblioteca',
    desc: 'Tu biblioteca de Steam con filtros que Steam no tiene.',
    ready: false,
    href: null,
  },
] as const;
---

<BaseLayout {title} {description} themed>
  <SiteHeader {user} themeToggle />

  <main id="main-content" class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="pitch">
        <p class="eyebrow">Para tu biblioteca de Steam</p>
        <h1 id="hero-title">
          Elige <span class="em">qué jugar</span> de tu biblioteca de Steam
        </h1>
        <p class="lede">Pega tu perfil y mira tu biblioteca. Sin registrarte.</p>
        <div class="hero-cta">
          <a class="cta" href={toolHref('/dashboard')}>Ir a mi dashboard</a>
          <a class="cta ghost" href="#herramientas">Herramientas</a>
        </div>
      </div>

      <div class="shelf-slot">
        <HeroSpines />
      </div>

      <div class="lookup-slot">
        <ProfileLookup user={!!user} client:load />
      </div>
    </section>

    <section id="herramientas" class="tools" aria-labelledby="tools-title">
      <h2 id="tools-title">Mis herramientas</h2>
      <ul class="capsules">
        {tools.map((t) => (
          <li>
            {t.ready ? (
              <a class="capsule" href={t.href}>
                <span class="capsule-art"><Icon name={t.icon} size={40} /></span>
                <span class="capsule-body">
                  <span class="capsule-tag">Con tu cuenta</span>
                  <span class="capsule-title">{t.title}</span>
                  <span class="capsule-desc">{t.desc}</span>
                </span>
              </a>
            ) : (
              <div class="capsule soon">
                <span class="capsule-art"><Icon name={t.icon} size={40} /></span>
                <span class="capsule-body">
                  <span class="capsule-tag">Próximamente</span>
                  <span class="capsule-title">{t.title}</span>
                  <span class="capsule-desc">{t.desc}</span>
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
      <p class="more"><i>Hay dos más en camino.</i></p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* Hallmark · macrostructure: Narrative Workflow (hero + 3 stages) · tone: technical, precise and calm, warmed by one amber accent · anchor hue: amber 60° */
  /* Hallmark · theme: studied-DNA locked by app/DESIGN.md (tokens.css, dark + light) · DNA-source: image · genre: modern-minimal */
  /* Hallmark · audience: any Steam player with a backlog, not only completionists (owner, 14/10/2026) */
  /* Hallmark · use: one action in the first screen: paste the profile, see the public library demo, then log in with Steam */
  /* Hallmark · nav: existing SiteHeader (wordmark + user chip + theme toggle, no central nav) · footer: existing SiteFooter · contrast: pass (40-41, token pairs measured >= 5.2:1 in DESIGN.md) */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R4 V4 */
  html,
  body {
    overflow-x: clip;
  }
  body {
    margin: 0;
    min-height: 100dvh;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    background: var(--color-bg);
    color: var(--color-text-body);
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  * {
    box-sizing: border-box;
  }
  a {
    color: inherit;
  }
</style>

<style>
  .page {
    inline-size: min(var(--container), calc(100% - 2 * var(--space-gutter)));
    margin-inline: auto;
    padding-block: var(--space-7) var(--space-9);
    display: grid;
    gap: var(--space-8);
  }

  h1,
  h2,
  h3 {
    color: var(--color-text);
    font-style: normal;
    overflow-wrap: anywhere;
  }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: end;
  }
  .pitch {
    min-inline-size: 0;
  }
  .eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  h1 {
    margin: 0;
    /* Sized to keep eyebrow, h1, lede and the lookup input in the first screen at 1280x800. */
    font-size: clamp(var(--text-3xl), 1.2rem + 3.2vw, 3.75rem);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .em {
    color: var(--color-accent-text);
  }
  .lede {
    max-inline-size: 48ch;
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    text-wrap: pretty;
  }
  .hero-cta {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .shelf-slot,
  .lookup-slot {
    min-inline-size: 0;
  }
  .lookup-slot {
    grid-column: 1 / -1;
  }

  /* ---------- buttons ---------- */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-bold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }
  .cta:hover {
    background: var(--color-accent-hover);
  }
  .cta:active {
    transform: translateY(1px);
  }
  .cta.ghost {
    background: transparent;
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }
  .cta.ghost:hover {
    background: var(--color-surface-2);
  }
  .cta:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* ---------- tools ---------- */
  .tools {
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }
  h2 {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
  }
  /* Vertical Steam-library-style capsules (decisiones A18). Padding leaves room for the hover glow. */
  .capsules {
    margin: var(--space-5) 0 0;
    padding: var(--space-4);
    list-style: none;
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .capsules > li {
    flex: none;
    inline-size: 11.5rem;
    scroll-snap-align: start;
  }
  .more {
    margin: 0;
    color: var(--color-text-muted);
  }
  .capsule {
    display: grid;
    grid-template-rows: 1fr auto;
    block-size: 100%;
    aspect-ratio: 2 / 3;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }
  .capsule-art {
    display: grid;
    place-items: center;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }
  .capsule-body {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .capsule-tag {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .capsule-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }
  .capsule-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  /* Dim only the art: the label and description are information and keep their contrast. */
  .capsule.soon .capsule-art {
    filter: saturate(0.15);
    opacity: 0.6;
  }
  .capsule.soon .capsule-tag {
    color: var(--color-text-muted);
  }
  a.capsule:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* ---------- breakpoints ---------- */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-6) var(--space-7);
    }
  }
  @media (max-width: 899px) {
    .page {
      gap: var(--space-7);
    }
  }
  @media (min-width: 600px) {
    .capsules {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.capsule:hover {
      transform: perspective(40rem) rotateX(2deg) rotateY(-4deg) translateY(-0.25rem);
      border-color: var(--color-accent);
      box-shadow: var(--glow-accent);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    a.capsule:hover {
      border-color: var(--color-accent);
      box-shadow: var(--glow-accent);
    }
  }
  @media (max-width: 480px) {
    .hero-cta .cta {
      flex: 1 1 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      transform: none;
    }
    .capsule {
      transition: none;
    }
  }
</style>
