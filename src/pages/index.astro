---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProfileLookup from '../components/ProfileLookup.svelte';

const user = Astro.locals.user;
const title = 'mysteamlib — de tu biblioteca de Steam a tu próximo platino';
const description =
  'Pega tu perfil de Steam y mira en segundos lo que esconde tu cuenta. Conecta con Steam y descubre qué juego te queda más cerca del 100 %.';

const steps = [
  {
    n: '01',
    title: 'Pega tu perfil',
    desc: 'Tu URL de Steam o tu SteamID. Miramos tus datos públicos y te enseñamos un resumen al momento — sin registrarte.',
  },
  {
    n: '02',
    title: 'Conéctate con Steam',
    desc: 'Un clic con OpenID. Nunca te pedimos la contraseña ni la guardamos; todo entra por la puerta oficial de Steam.',
  },
  {
    n: '03',
    title: 'Decide con datos',
    desc: 'Logros, horas, rareza y tiempo estimado ordenados: sabes cuál es tu próximo platino y por qué.',
  },
];

const perks = [
  {
    id: 'platino',
    href: user ? '/platino' : '/api/auth/login?next=/platino',
    title: 'Mi próximo platino',
    desc: 'Tus juegos con logros pendientes, ordenados por lo cerca que estás del 100&nbsp;%. Filtra por logros, horas, género y dificultad real — y deja de adivinar.',
  },
  {
    id: 'dashboard',
    href: user ? '/dashboard' : '/api/auth/login?next=/dashboard',
    title: 'Mi dashboard',
    desc: 'Tu juego en una ficha: perfil, logros desbloqueados, platinados y horas. Todo a un clic de distancia.',
  },
  {
    id: 'logros',
    href: user ? '/platino' : '/api/auth/login?next=/platino',
    title: 'Cada logro, contado',
    desc: 'Estado 1×1 de cada logro desde Steam: cuáles te faltan, cuáles son raros de verdad y cuántos has desbloqueado.',
  },
  {
    id: 'fresco',
    href: user ? '/platino' : '/api/auth/login?next=/platino',
    title: 'Siempre al día',
    desc: 'Tus datos se actualizan solos con el mínimo de llamadas a Steam —y puedes forzar la refrescada cuando quieras.',
  },
];

const trust = [
  'Entras con OpenID: no guardamos ni pedimos tu contraseña en ningún momento.',
  'Solo leemos lo que tú nos enseñas: perfil público o nada.',
  'Los datos vienen «tal cual» de Steam, con avisos cuando algo es una estimación.',
  'No tenemos ninguna relación con Valve ni con Steam (aunque les queremos mucho).',
];
---

<BaseLayout {title} {description}>
  <SiteHeader {user} page="home" />

  <main id="main-content" class="page">
    <section class="hero">
      <div class="pitch">
        <p class="kicker">Steam · Progreso · Platinados</p>
        <h1>
          Tu biblioteca de Steam, de caos
          <br />
          a <span class="grad">tu próximo platino</span>
        </h1>
        <p class="lede">
          Pega tu perfil y mira en segundos lo que esconde tu cuenta. Conecta con Steam y
          Mysteamlib te dice qué juego te queda más cerca del 100&nbsp;% — con horas,
          dificultad y rareza reales detrás.
        </p>
        <ul class="promise">
          <li><strong>Sin contraseñas:</strong> entras con tu cuenta de Steam (OpenID), nada más.</li>
          <li><strong>Gratis siempre:</strong> hecho para colecciones de verdad, no para maratones.</li>
          <li><strong>Solo tu perfil:</strong> no miramos las bibliotecas de nadie más.</li>
        </ul>
        {user && (
          <div class="logged-cta">
            <a class="cta" href="/dashboard">Ir a mi dashboard</a>
            <a class="cta ghost" href="/platino">Mi próximo platino</a>
          </div>
        )}
      </div>

      <div class="lookup-card">
        <ProfileLookup user={!!user} client:load />
      </div>
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title">Así de fácil</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="perks" aria-labelledby="perks-title">
      <div class="section-head">
        <h2 id="perks-title">Qué te llevas al entrar</h2>
        <p>Todo tu juego de Steam, ordenado y con criterio. Con tu cuenta, claro.</p>
      </div>
      <div class="perk-grid">
        {perks.map((p) => (
          <a class="perk" href={p.href}>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="perk-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="trust" aria-labelledby="trust-title">
      <div class="section-head">
        <h2 id="trust-title">Sin letra pequeña rara</h2>
        <p>Y de regalo, una política de privacidad que se entiende.</p>
      </div>
      <ul class="trust-list">
        {trust.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0a0e17;
    --surface: #111724;
    --surface-2: #141b2b;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --border: rgba(148, 163, 184, 0.16);
    --accent: #7c8dff;
    --accent-2: #b06ab3;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background:
      radial-gradient(1200px 600px at 85% -10%, rgba(124, 141, 255, 0.14), transparent 60%),
      radial-gradient(900px 500px at -10% 10%, rgba(176, 106, 179, 0.12), transparent 55%),
      var(--bg);
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  * {
    box-sizing: border-box;
  }
  a {
    color: inherit;
  }
</style>

<style>
  .page {
    max-width: min(76rem, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2.5rem 0 4.5rem;
    display: grid;
    gap: 4.5rem;
  }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .kicker {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #7c8dff);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-wrap: balance;
  }
  .grad {
    background: linear-gradient(90deg, #a5b4fc, #e0a3e3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    max-width: 34rem;
    margin: 1.1rem 0 0;
    color: var(--muted, #94a3b8);
    font-size: 1.05rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .promise {
    margin: 1.4rem 0 0;
    padding: 1.1rem 1.2rem;
    list-style: none;
    display: grid;
    gap: 0.55rem;
    border-radius: 16px;
    border: 1px dashed var(--border, rgba(148, 163, 184, 0.3));
    background: rgba(17, 23, 36, 0.5);
    font-size: 0.92rem;
    color: var(--muted, #94a3b8);
    line-height: 1.5;
  }
  .promise strong {
    color: var(--text, #f1f5f9);
  }
  .logged-cta {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    background: linear-gradient(135deg, #7c8dff, #b06ab3);
    color: #0a0e17;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta.ghost {
    background: transparent;
    color: var(--text, #f1f5f9);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.35));
  }
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(124, 141, 255, 0.35);
  }
  .cta.ghost:hover {
    box-shadow: none;
    border-color: rgba(124, 141, 255, 0.5);
  }
  .cta:focus-visible,
  .perk:focus-visible {
    outline: 2px solid var(--accent, #7c8dff);
    outline-offset: 3px;
  }

  .lookup-card {
    padding: 1.35rem;
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgba(17, 23, 36, 0.92), rgba(20, 27, 43, 0.9)),
      var(--surface, #111724);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.24));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  /* ---------- how ---------- */
  .how h2,
  .section-head h2 {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent, #7c8dff);
  }
  .steps {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .step {
    position: relative;
    padding: 1.3rem 1.3rem 1.1rem;
    border-radius: 18px;
    background: var(--surface, #111724);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(124, 141, 255, 0.28), rgba(176, 106, 179, 0.22));
    color: #c7d2fe;
    font-weight: 800;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .step h3 {
    margin: 0.8rem 0 0.35rem;
    font-size: 1.05rem;
  }
  .step p {
    margin: 0;
    color: var(--muted, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* ---------- perks ---------- */
  .section-head p {
    margin: 0;
    color: var(--muted, #94a3b8);
    font-size: 0.98rem;
  }
  .perk-grid {
    margin-top: 1.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .perk {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.3rem;
    border-radius: 18px;
    background: var(--surface, #111724);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .perk:hover {
    border-color: rgba(124, 141, 255, 0.45);
    background: var(--surface-2, #141b2b);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
  }
  .perk h3 {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-right: 1.4rem;
  }
  .perk p {
    margin: 0;
    color: var(--muted, #94a3b8);
    font-size: 0.87rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .perk-go {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    font-size: 1.1rem;
    color: var(--accent, #7c8dff);
  }

  /* ---------- trust ---------- */
  .trust-list {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }
  .trust-list li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    color: var(--muted, #94a3b8);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .trust-list li::before {
    content: '✓';
    flex: none;
    color: var(--accent, #7c8dff);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .page {
      gap: 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta,
    .perk {
      transition: none;
    }
    .cta:hover,
    .perk:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>