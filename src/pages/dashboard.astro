---
import DashLayout from '../layouts/DashLayout.astro';
import { db } from '../lib/db/client';
import { games, userGames, users } from '../lib/db/schema';
import { and, eq, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
const title = 'Mi Dashboard · mysteamlib';
const description =
  'Mi resumen de juego: perfil de Steam, logros desbloqueados, platinados y horas, con acceso a todas las herramientas.';

const profile = (await db
  .select({
    personaName: users.personaName,
    avatarUrl: users.avatarUrl,
    steamId: users.steamId,
    profileVisibility: users.profileVisibility,
    lastSyncedAt: users.lastSyncedAt,
  })
  .from(users)
  .where(eq(users.id, user.userId))
  .limit(1))[0];

// First login without imported data → pasarela de primera carga.
if (profile && !profile.lastSyncedAt) {
  return Astro.redirect('/sync?from=/dashboard');
}

const stats = {
  games: 0,
  unlocked: 0,
  playtimeHours: 0,
  platinized: 0,
};

if (db && profile) {
  const g = (
    await db
      .select({ n: sql`count(*)::int` })
      .from(userGames)
      .where(eq(userGames.userId, user.userId))
  )[0];
  const u = (
    await db
      .select({ n: sql`coalesce(sum(${userGames.achievementsUnlocked}), 0)::int` })
      .from(userGames)
      .where(eq(userGames.userId, user.userId))
  )[0];
  const h = (
    await db
      .select({ m: sql`coalesce(sum(${userGames.playtimeMinutes}), 0)::bigint` })
      .from(userGames)
      .where(eq(userGames.userId, user.userId))
  )[0];
  const p = (
    await db
      .select({ n: sql`count(*)::int` })
      .from(userGames)
      .innerJoin(games, eq(games.appid, userGames.appid))
      .where(
        and(
          eq(userGames.userId, user.userId),
          sql`${games.totalAchievements} > 0 and ${userGames.achievementsUnlocked} >= ${games.totalAchievements}`,
        ),
      )
  )[0];
  stats.games = g?.n ?? 0;
  stats.unlocked = u?.n ?? 0;
  stats.playtimeHours = Math.round((Number(h?.m ?? 0) / 60) * 10) / 10;
  stats.platinized = p?.n ?? 0;
}

const lastSync = profile?.lastSyncedAt;
const visibilityLabel = profile?.profileVisibility === 'private' ? 'Privado' : 'Público';

const statCards = [
  { label: 'Juegos en mi biblioteca', value: stats.games },
  { label: 'Logros desbloqueados', value: stats.unlocked },
  { label: 'Platinados', value: stats.platinized },
  { label: 'Horas jugadas', value: stats.playtimeHours },
];
---

<DashLayout {title} {description} page="dashboard" user={user}>
  <main id="main-content" class="page">
    <div class="hero">
      <h1>Mi Dashboard</h1>
      <p class="lede">
        Mi resumen de juego: perfil, logros y horas, y el arranque a todas las
        herramientas de mysteamlib.
      </p>
    </div>

    <section class="profile card" aria-label="Mi perfil">
      {profile?.avatarUrl ? (
        <img
          class="avatar"
          src={profile.avatarUrl}
          alt="Foto de perfil de Steam"
          width="64"
          height="64"
          referrerpolicy="no-referrer"
        />
      ) : (
        <div class="avatar avatar-fallback" aria-hidden="true">?</div>
      )}
      <div class="profile-meta">
        <h2>{profile?.personaName ?? profile?.steamId}</h2>
        <p class="sub">
          <span class="steamid">{profile?.steamId}</span>
          <span class="dot" aria-hidden="true">·</span>
          Perfil {visibilityLabel}
        </p>
      </div>
      <p class="sync-note">
        {!lastSync
          ? 'Mi biblioteca aún no se ha sincronizado.'
          : `Última sincronización: ${lastSync.toLocaleString('es-ES', {
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            })}`}
      </p>
    </section>

    <section class="stats" aria-label="Mis estadísticas">
      {statCards.map((s) => (
        <div class="card stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </section>

    <section class="tools" aria-label="Mis herramientas">
      <h2>Mis herramientas</h2>
      <a class="card tool" href="/platino">
        <div>
          <h3>Mi próximo platino</h3>
          <p>
            Mi lista de juegos con logros pendientes, filtrable y ordenable por
            lo cerca que estoy del 100&nbsp;%.
          </p>
        </div>
        <span class="go" aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</DashLayout>

<style>
  .page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
    text-wrap: balance;
    background: linear-gradient(90deg, #a5b4fc, #e0a3e3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    margin: 0 0 1.5rem;
    color: var(--muted);
    max-width: 46rem;
    line-height: 1.5;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    flex-wrap: wrap;
  }
  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid rgba(124, 141, 255, 0.35);
    object-fit: cover;
  }
  .avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--muted);
  }
  .profile-meta {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .profile-meta h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .steamid {
    font-variant-numeric: tabular-nums;
  }
  .dot {
    opacity: 0.5;
  }
  .sync-note {
    margin: 0 0 0 auto;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 2rem;
  }
  .stat {
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.2rem;
  }
  .stat-value {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .tools h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .tool:hover {
    border-color: rgba(124, 141, 255, 0.45);
    background: var(--surface-2);
    transform: translateY(-1px);
  }
  .tool h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }
  .tool p {
    margin: 0;
    color: var(--muted);
    font-size: 0.87rem;
    line-height: 1.45;
    max-width: 36rem;
  }
  .go {
    font-size: 1.3rem;
    color: var(--accent);
  }
</style>