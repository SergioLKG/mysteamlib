---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  page: 'dashboard' | 'platino';
  steamId: string;
}

const { title, page, steamId } = Astro.props;
---

<BaseLayout {title}>
  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #0a0e17;
      --surface: #111724;
      --surface-2: #141b2b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.16);
      --accent: #7c8dff;
      --accent-2: #b06ab3;
      --radius: 14px;
    }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background:
        radial-gradient(1200px 600px at 85% -10%, rgba(124, 141, 255, 0.14), transparent 60%),
        radial-gradient(900px 500px at -10% 10%, rgba(176, 106, 179, 0.12), transparent 55%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
    }
    * {
      box-sizing: border-box;
    }
    a {
      color: inherit;
    }
  </style>

  <header class="site-header">
    <a class="brand" href="/">mysteamlib</a>
    <nav aria-label="Principal">
      <a href="/dashboard" aria-current={page === 'dashboard' ? 'page' : undefined}>Mi Dashboard</a>
      <a href="/platino" aria-current={page === 'platino' ? 'page' : undefined}>Mi próximo platino</a>
      <span class="who">{steamId}</span>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="ghost">Cerrar sesión</button>
      </form>
    </nav>
  </header>

  <slot />
</BaseLayout>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    color: inherit;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
  .who {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ghost {
    font: inherit;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .ghost:hover {
    color: var(--text);
    border-color: var(--border);
  }
</style>