---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface SessionUser {
  userId: string;
  steamId: string;
}

interface Props {
  title: string;
  description?: string;
  page: 'dashboard' | 'platino' | 'sync';
  user: SessionUser;
}

const { title, description, page, user } = Astro.props;
---

<BaseLayout {title} {description}>
  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #0a0e17;
      --surface: #111724;
      --surface-2: #141b2b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.16);
      --accent: #7c8dff;
      --accent-2: #b06ab3;
      --accent-3: #f04040;
      --radius: 14px;
      --header-h: 3.875rem;
    }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background:
        radial-gradient(1200px 600px at 85% -10%, rgba(124, 141, 255, 0.14), transparent 60%),
        radial-gradient(900px 500px at -10% 10%, rgba(176, 106, 179, 0.12), transparent 55%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
    }
    * {
      box-sizing: border-box;
    }
    a {
      color: inherit;
    }
  </style>

  <SiteHeader {user} {page} />

  <slot />
</BaseLayout>