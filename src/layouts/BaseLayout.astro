---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.svelte';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/tokens.css';
import { THEME_COLOR } from '../lib/ui/theme-colors';

interface Props {
  title?: string;
  description?: string;
  /** Legal pages set it to false to get a full-width footer. */
  containedFooter?: boolean;
  /**
   * true = page already uses the design tokens: follows the OS theme or the saved choice.
   * false (default, legacy pages) = pinned to dark until the page is migrated (Phases 11/12).
   */
  themed?: boolean;
  /** Absolute or root-relative URL of the 1200x630 Open Graph image. No og:image without it. */
  ogImage?: string;
  /** Private or transient pages: kept out of the index and without canonical. */
  noindex?: boolean;
  /** Structured data, serialised into a JSON-LD script. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'mysteamlib',
  description,
  containedFooter = true,
  themed = false,
  ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;

// Query strings never reach the canonical, so tracking params do not split the page.
// A trailing slash is dropped (except the root) so `/privacidad/` and `/privacidad` share one canonical.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
// `<` is escaped so a string value can never close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="es" data-theme={themed ? undefined : 'dark'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {themed ? (
      <>
        <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
        <script is:inline>
          try {
            var t = localStorage.getItem('mysteamlib-theme');
            if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
          } catch (e) {}
        </script>
      </>
    ) : (
      <meta name="theme-color" content={THEME_COLOR.legacy} />
    )}
    <link rel="preconnect" href="https://media.steampowered.com" crossorigin />
    <link rel="preconnect" href="https://avatars.steamstatic.com" crossorigin />
    <link rel="preconnect" href="https://community.fastly.steamstatic.com" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    {description && <meta name="description" content={description} />}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="mysteamlib" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:title" content={title} />
        <meta property="og:url" content={canonical} />
        {description && <meta property="og:description" content={description} />}
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
      </>
    )}
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
    <SiteFooter contained={containedFooter} />
    <BackToTop client:idle />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 0 0 10px 0;
    background: var(--accent, var(--color-accent));
    color: var(--color-on-accent);
    font-weight: 700;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 0;
  }
</style>

<style is:global>
  main[id] {
    scroll-margin-top: calc(var(--header-h, 3.875rem) + 1rem);
  }

  /* "Ficha" ruling: hero and footer backgrounds only, never behind dense text (DESIGN.md, Layout). */
  .ruled {
    /* Margin line position: a page can set `--rule-margin-x` to follow its own layout. */
    --rule-x: var(--rule-margin-x, calc(var(--space-gutter) * 2));
    background-image:
      linear-gradient(
        to right,
        transparent var(--rule-x),
        color-mix(in oklch, var(--color-accent-mark) 35%, transparent) var(--rule-x) calc(var(--rule-x) + 1px),
        transparent calc(var(--rule-x) + 1px)
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(var(--rule-gap) - 1px),
        var(--color-rule) calc(var(--rule-gap) - 1px) var(--rule-gap)
      );
  }
  @media (forced-colors: active) {
    .ruled {
      background-image: none;
    }
  }
</style>
