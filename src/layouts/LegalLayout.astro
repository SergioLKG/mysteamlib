---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  updated: string;
  user?: { userId: string; steamId: string } | null;
}

const { title, heading, description, updated, user = Astro.locals.user } = Astro.props;
---

<BaseLayout {title} {description}>
  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #0a0e17;
      --surface: #111724;
      --surface-2: #141b2b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.16);
      --accent: var(--color-accent);
      --accent-2: var(--color-accent-hover);
      --header-h: 3.875rem;
    }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
    }
    * {
      box-sizing: border-box;
    }
    a {
      color: inherit;
    }
  </style>

  <SiteHeader {user} loginGlyph={false} />

  <main id="main-content" class="legal">
    <header class="legal-head">
      <h1>{heading}</h1>
      <p class="updated">Última actualización:{" "}{updated}</p>
    </header>
    <slot />
  </main>
</BaseLayout>

<style>
  .legal {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 2rem;
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .legal :global(h2) {
    margin: 2.4rem 0 0.7rem;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .legal :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
  }
  .legal :global(p) {
    margin: 0 0 0.9rem;
    color: var(--muted, #cbd5e1);
  }
  .legal :global(p strong),
  .legal :global(li strong) {
    color: var(--text, #f1f5f9);
  }
  .legal :global(ul),
  .legal :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--muted, #cbd5e1);
  }
  .legal :global(li) {
    margin-bottom: 0.45rem;
  }
  .legal :global(a) {
    color: var(--accent, var(--color-accent));
  }
  .legal :global(a:focus-visible) {
    outline: 2px solid var(--accent, var(--color-accent));
    outline-offset: 3px;
    border-radius: 4px;
  }
  .legal :global(code) {
    padding: 0.1rem 0.3rem;
    border-radius: 5px;
    background: var(--surface-2, #141b2b);
    font-size: 0.86em;
  }
  .legal-head {
    margin-bottom: 2rem;
  }
  .legal :global(h1) {
    margin: 0 0 0.4rem;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.025em;
  }
  .updated {
    margin: 0;
    color: var(--muted, #94a3b8);
    font-size: 0.82rem;
  }
  .legal :global(.callout) {
    margin: 0 0 1.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(124, 141, 255, 0.35);
    border-radius: 14px;
    background: rgba(124, 141, 255, 0.07);
    color: var(--muted, #cbd5e1);
    font-size: 0.92rem;
  }
  .legal :global(.callout strong) {
    color: var(--text, #f1f5f9);
  }
  .legal :global(table) {
    width: 100%;
    margin: 0 0 1.2rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .legal :global(th),
  .legal :global(td) {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    text-align: left;
    vertical-align: top;
  }
  .legal :global(th) {
    color: var(--text, #f1f5f9);
    font-weight: 700;
  }
  .legal :global(td) {
    color: var(--muted, #cbd5e1);
  }
</style>
