# Postgres (Neon) connection string
DATABASE_URL=

# Steam Web API key (from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Public origin used for Steam OpenID realm / return URL.
# Dev: http://localhost:4321   Prod: https://mysteamlib.vercel.app
STEAM_OPENID_REALM=

# Secret used to sign session cookies (long random string)
SESSION_SECRET=

# Bearer token that Vercel sends to cron endpoints. Required in production:
# without it /api/cron/* rejects every request. Optional in local dev.
CRON_SECRET=

# HowLongToBeat (public game completion times). Enabled by default since v1.1.
# Set to "false" to turn the integration off without a code deploy.
HLTB_ENABLED=true

# Optional: minimum ms between HLTB requests. Default 1200. Raise it (e.g. 2000)
# for bulk local backfills to be gentler with the unofficial endpoint.
HLTB_MIN_INTERVAL_MS=1200
